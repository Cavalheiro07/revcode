# Banco (rodando a API fora do Docker, aponte para o Postgres do docker compose, exposto na 55432)
DATABASE_URL=postgresql://revcode:revcode@localhost:55432/revcode
# Banco usado pelos testes (criado pelo docker/init-test-db.sql)
TEST_DATABASE_URL=postgresql://revcode:revcode@localhost:55432/revcode_test

# Servidor
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
TIMEZONE=America/Sao_Paulo

# Autenticação (troque o segredo em produção; mínimo 16 caracteres)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d
# Tentativas de login/cadastro por minuto, por IP
AUTH_RATE_LIMIT_MAX=10

# Administrador criado pelo seed
ADMIN_EMAIL=admin@revcode.dev
ADMIN_PASSWORD=admin12345
